# Production env template. Copy to .env.deploy on the VPS and fill values.
# NEVER commit .env.deploy. Values migrate from Mac: provider keys from
# apps/gateway/.env, auth/github/db from apps/web/.env* + root .env.
POSTGRES_PASSWORD=change-me-32-chars-min

# --- gateway (from apps/gateway/.env) ---
CAMEL_API_KEY=
CAMEL_BASE_URL=
AGNES_API_KEY=
STEPFUN_API_KEY=
FEIHOA_API_KEY=
YOLO_AUTO_API_KEY=
LLMGATEWAY_API_KEY=
GENERALCOMPUTE_API_KEY=
HYPER_API_KEY=
HYPER_API_KEYS=
BHASKARA_COMPACT_THRESHOLD=
BHASKARA_COMPACT_SPAN=
BHASKARA_QWEN_SMART=
BHASKARA_BACKCHANNEL=
HYPER_DAILY_BUDGET_USD=
TRIAL_AGE_H=
TRIAL_HOURLY_TOKENS=
LOCK_SWITCH_COOLDOWN_MS=
LOCK_DOWN_STREAK=
ARCHIVE_TURNS=

# --- web (from apps/web/.env* + root .env) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://bhaskaralabs.com
DATABASE_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
