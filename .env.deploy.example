# Production env template. Copy to .env.deploy on the VPS and fill values.
# NEVER commit .env.deploy. Values migrate from Mac: provider keys from
# apps/gateway/.env, auth/github/db from apps/web/.env* + root .env.
POSTGRES_PASSWORD=change-me-32-chars-min

# --- gateway (from apps/gateway/.env) ---
#
# Only the hardcoded lanes live here. Every other provider — teamorouter,
# electronhub, openference, pareto, and anything added later — is configured in
# the admin panel and stored in the database, so its key is NOT in this file.
# See docs/provider-keys.md.
#
# Fleet keys still have to reach the VPS once, as environment for the seeder
# rather than for the gateway. Run this there before switching traffic:
#
#   TEAMOROUTER_API_KEY=… ELECTRONHUB_API_KEY=… OPENFERENCE_API_KEY=… \
#   PARETO_API_KEY=… PARETO_API_KEY_2=… \
#     bun apps/gateway/src/db/seed-fleet.ts --apply
#
# ELECTRONHUB_API_KEY must be a DevPass key (`ek-dev-…`), not a regular `ek-…`
# one. Both authenticate and both pass /models, but only a DevPass key is
# allowed to call the `:dev` models the ladder asks for — a regular key 403s on
# every one of them. The seeder writes the key into upstream_accounts and never
# deletes an account, so re-running it cannot wipe a key that is already there;
# it skips accounts whose env var is unset.
#
# Empty rules are a silent allow, so a fleet that was never seeded does not
# fail loudly — the ladder just skips those lanes and lands on Hyper.
CAMEL_API_KEY=
CAMEL_BASE_URL=
AGNES_API_KEY=
STEPFUN_API_KEY=
LLMGATEWAY_API_KEY=
HYPER_API_KEY=
HYPER_API_KEYS=
BHASKARA_COMPACT_THRESHOLD=
BHASKARA_COMPACT_SPAN=
HYPER_DAILY_BUDGET_USD=
TRIAL_AGE_H=
TRIAL_HOURLY_TOKENS=
LOCK_SWITCH_COOLDOWN_MS=
LOCK_DOWN_STREAK=
ARCHIVE_TURNS=
# off | observe | enforce. Observe by default: read scripts/ua-report.ts output
# before enforcing, or a real client gets refused.
BHASKARA_UA_GATE=

# --- web (from apps/web/.env* + root .env) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://bhaskaralabs.com
DATABASE_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
