# NOTE (Cloudflare Flexible proxy in front): scheme http:// disables Caddy's
# auto-https redirect (the edge terminates TLS; origin serves plain HTTP).
# Redirect loop otherwise: CF→origin HTTP → Caddy 308 → CF → … When moving to
# Full (strict), drop the http:// prefixes again so Caddy issues public certs.
http://api.bhaskaralabs.com {
	reverse_proxy gateway:8793
}

http://bhaskaralabs.com, http://www.bhaskaralabs.com {
	reverse_proxy web:3000
}
